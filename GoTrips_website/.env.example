# GoTrip API (the same backend the apps use). Add this website's origin to CORS_ORIGINS on the API.
VITE_API_URL=http://localhost:3000/api/v1
# Store links shown on the site (leave empty to hide a button)
VITE_USER_APP_URL=https://play.google.com/store/apps/details?id=in.gotrip.user
VITE_PARTNER_APP_URL=https://play.google.com/store/apps/details?id=in.gotrip.partner
# Business details used on the contact / legal pages
VITE_COMPANY_NAME=GoTrip
VITE_COMPANY_ADDRESS=Guwahati, Assam, India
