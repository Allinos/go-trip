# ============================================================
# GoTrip API configuration. Copy to .env and fill in.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================
NODE_ENV=development
PORT=3000
# Public URL of this API (used for signed file links and the Razorpay checkout page)
PUBLIC_BASE_URL=http://localhost:3000
# Number of reverse proxies in front (nginx = 1). Needed for correct client IPs / rate limits.
TRUST_PROXY=1
# Comma-separated browser origins allowed to call the API (admin panel). Mobile apps need no entry.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# ---------- Database ----------
# connection_limit = pool size per Node process. With PM2 (N workers) keep N x limit < Postgres max_connections.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gotrip?schema=public&connection_limit=15&pool_timeout=10"
# Strongly recommended in production (PM2 cluster / several servers): shared cache + rate-limit counters
# REDIS_URL=redis://localhost:6379
# Multiply every rate limit. Raise (e.g. 3) if many users reach you through one mobile-carrier IP.
RATE_LIMIT_MULTIPLIER=1

# ---------- Auth ----------
JWT_ACCESS_SECRET=change_me_to_a_random_string_of_at_least_32_chars_1
JWT_REFRESH_SECRET=change_me_to_a_random_string_of_at_least_32_chars_2
JWT_ADMIN_SECRET=change_me_to_a_random_string_of_at_least_32_chars_3
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=60
ADMIN_TOKEN_TTL=8h
OTP_SECRET=change_me_random_16plus
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Fixed OTP for app-store review accounts only, e.g. +919999999999:123456
OTP_TEST_NUMBERS=

# ---------- File storage ----------
# local = files on this server's disk (single server / dev). s3 = AWS S3 or Cloudflare R2 (recommended in production).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
FILE_URL_SECRET=change_me_random_16plus
MAX_UPLOAD_MB=8
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2 (no egress fees): https://<account-id>.r2.cloudflarestorage.com  and AWS_REGION=auto
S3_ENDPOINT=

# ---------- Razorpay (registration fee) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL: <PUBLIC_BASE_URL>/api/v1/payments/webhook/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---------- SMS ----------
# console (dev) | fast2sms | msg91 | twilio
SMS_PROVIDER=console
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_OTP_TEMPLATE_ID=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Email (any SMTP: Amazon SES, Brevo, Gmail app password) ----------
EMAIL_ENABLED=false
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GoTrip <no-reply@gotrip.in>"

# ---------- Firebase Cloud Messaging ----------
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Background jobs (expire requests, auto-complete trips, listing expiry, payment reconciliation)
JOBS_ENABLED=true
