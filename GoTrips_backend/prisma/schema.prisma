// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// USERS & AUTHENTICATION
// =====================================================

model User {
  user_id           BigInt    @id @default(autoincrement())
  phone_number      String    @unique @db.VarChar(20)
  country_code      String    @default("+91") @db.VarChar(5)
  full_name         String?   @db.VarChar(100)
  email             String?   @unique @db.VarChar(100)
  profile_photo_url String?   @db.VarChar(255)
  date_of_birth     DateTime? @db.Date
  gender            Gender?
  user_type         UserType  @default(passenger)
  is_verified       Boolean   @default(false)
  is_active         Boolean   @default(true)
  terms_accepted    Boolean   @default(false)
  privacy_accepted  Boolean   @default(false)
  profile_filled    Boolean   @default(false)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  last_login        DateTime? @db.Timestamp(0)

  // Relations
  otp_verifications  OtpVerification[]
  saved_locations    UserSavedLocation[]
  partner            Partner?
  created_rides      Ride[]              @relation("RideCreator") // Changed from "created_rides"
  passenger_rides    Ride[]              @relation("RidePassenger")
  payer_payments     Payment[]           @relation("payer_payments")
  payee_payments     Payment[]           @relation("payee_payments")
  rental_bookings    RentalBooking[]
  reviews_given      RatingsReview[]     @relation("reviewer")
  reviews_received   RatingsReview[]     @relation("reviewee")
  notifications      Notification[]
  push_tokens        PushToken[]
  support_tickets    SupportTicket[]
  promo_usage        PromoUsage[]
  emergency_contacts EmergencyContact[]
  sos_alerts         SosAlert[]
  app_sessions       AppSession[]
  search_logs        SearchLog[]
  driverLeadUnlocks  DriverLeadUnlock[]
  rides              Ride[]
  rideBookings       RideBooking[]

  @@index([phone_number])
  @@index([email])
  @@map("users")
}

model OtpVerification {
  otp_id       BigInt   @id @default(autoincrement())
  user_id      BigInt?
  phone_number String   @db.VarChar(20)
  otp_code     String   @db.VarChar(6)
  otp_type     OtpType  @default(login)
  is_verified  Boolean  @default(false)
  expires_at   DateTime @db.Timestamp(0)
  created_at   DateTime @default(now()) @db.Timestamp(0)

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([phone_number, otp_code])
  @@map("otp_verification")
}

model UserSavedLocation {
  location_id   BigInt       @id @default(autoincrement())
  user_id       BigInt
  location_type LocationType
  location_name String?      @db.VarChar(100)
  address       String       @db.Text
  latitude      Decimal?     @db.Decimal(10, 8)
  longitude     Decimal?     @db.Decimal(11, 8)
  landmark      String?      @db.VarChar(255)
  created_at    DateTime     @default(now()) @db.Timestamp(0)

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_saved_locations")
}

// =====================================================
// PARTNER/DRIVER MANAGEMENT
// =====================================================

model Partner {
  partner_id            BigInt             @id @default(autoincrement())
  user_id               BigInt             @unique
  partner_type          PartnerType
  business_name         String?            @db.VarChar(100)
  verification_status   VerificationStatus @default(pending)
  verification_date     DateTime?          @db.Timestamp(0)
  rejection_reason      String?            @db.Text
  is_online             Boolean            @default(false)
  bank_account_number   String?            @db.VarChar(50)
  bank_ifsc_code        String?            @db.VarChar(20)
  bank_account_holder   String?            @db.VarChar(100)
  upi_id                String?            @db.VarChar(100)
  rating_average        Decimal            @default(0.00) @db.Decimal(3, 2)
  total_rides_completed Int                @default(0)
  total_earnings        Decimal            @default(0.00) @db.Decimal(10, 2)
  pending_payout        Decimal            @default(0.00) @db.Decimal(10, 2)
  language_preference   String             @default("en") @db.VarChar(10)
  created_at            DateTime           @default(now()) @db.Timestamp(0)
  updated_at            DateTime           @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  user                     User                      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  documents                PartnerDocument[]
  vehicles                 Vehicle[]
  driver_rides             Ride[]                    @relation("RideDriver")
  owner_rentals            RentalBooking[]           @relation("owner_rentals")
  earnings                 PartnerEarning[]
  subscriptions            PartnerSubscription[]
  driverMarketplaceProfile DriverMarketplaceProfile?
  driverLeadUnlocks        DriverLeadUnlock[]
  rides                    Ride[]

  @@index([partner_type])
  @@index([verification_status])
  @@map("partners")
}

model PartnerDocument {
  document_id         BigInt                @id @default(autoincrement())
  partner_id          BigInt
  document_type       DocumentType
  document_number     String?               @db.VarChar(100)
  document_url        String                @db.VarChar(255)
  verification_status DocVerificationStatus @default(pending)
  expiry_date         DateTime?             @db.Date
  uploaded_at         DateTime              @default(now()) @db.Timestamp(0)
  verified_at         DateTime?             @db.Timestamp(0)

  // Relations
  partner Partner @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@index([partner_id])
  @@map("partner_documents")
}

// =====================================================
// VEHICLE MANAGEMENT
// =====================================================

model Vehicle {
  vehicle_id            BigInt          @id @default(autoincrement())
  partner_id            BigInt
  vehicle_type          VehicleType
  vehicle_category      VehicleCategory
  manufacturer          String?         @db.VarChar(50)
  model                 String?         @db.VarChar(50)
  year                  Int?
  color                 String?         @db.VarChar(30)
  number_plate          String          @unique @db.VarChar(20)
  seating_capacity      Int?
  fuel_type             FuelType?
  ac_available          Boolean         @default(false)
  is_available          Boolean         @default(true)
  is_verified           Boolean         @default(false)
  rental_price_per_hour Decimal?        @db.Decimal(10, 2)
  rental_price_per_day  Decimal?        @db.Decimal(10, 2)
  ride_price_per_km     Decimal?        @db.Decimal(10, 2)
  base_fare             Decimal?        @db.Decimal(10, 2)
  vehicle_photos        Json? // Array of photo URLs
  features              Json? // Array of features
  rating_average        Decimal         @default(0.00) @db.Decimal(3, 2)
  total_trips           Int             @default(0)
  created_at            DateTime        @default(now()) @db.Timestamp(0)
  updated_at            DateTime        @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  partner         Partner         @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  rides           Ride[]
  rental_bookings RentalBooking[]
  reviews         RatingsReview[]

  @@index([vehicle_type])
  @@index([is_available])
  @@index([number_plate])
  @@map("vehicles")
}

// =====================================================
// RIDE MANAGEMENT
// =====================================================

model Ride {
  ride_id BigInt @id @default(autoincrement())

  // RIDE CREATION
  created_by   BigInt // Partner who created the ride
  ride_type    RideType @default(fixed_route)
  is_published Boolean  @default(true)

  // VEHICLE & DRIVER
  vehicle_id BigInt
  driver_id  BigInt? // Partner who will drive

  // ROUTE
  pickup_location_lat Decimal? @db.Decimal(10, 8)
  pickup_location_lng Decimal? @db.Decimal(11, 8)
  pickup_address      String?  @db.VarChar(255)

  drop_location_lat Decimal? @db.Decimal(10, 8)
  drop_location_lng Decimal? @db.Decimal(11, 8)
  drop_address      String?  @db.VarChar(255)

  // CAPACITY MANAGEMENT
  total_seats           Int?
  total_capacity_kg     Decimal? @db.Decimal(10, 2)
  available_seats       Int?
  available_capacity_kg Decimal? @db.Decimal(10, 2)

  // PRICING
  fare_amount    Decimal? @db.Decimal(10, 2)
  price_per_seat Decimal? @db.Decimal(10, 2)
  price_per_km   Decimal? @db.Decimal(10, 2)
  base_fare      Decimal? @db.Decimal(10, 2)

  // SCHEDULE
  scheduled_departure_time DateTime?
  estimated_arrival_time   DateTime?

  // RIDE DETAILS
  distance_km      Decimal? @db.Decimal(10, 2)
  duration_minutes Int?
  ride_category    String?  @db.VarChar(50)

  // RIDE EXECUTION
  passenger_id       BigInt? // User who booked
  booked_seats       Int?
  booked_capacity_kg Decimal? @db.Decimal(10, 2)

  actual_pickup_time DateTime?
  actual_drop_time   DateTime?

  ride_status         RideStatus @default(pending)
  cancellation_reason String?    @db.Text

  // PAYMENT
  total_fare          Decimal?      @db.Decimal(10, 2)
  platform_commission Decimal?      @db.Decimal(10, 2)
  driver_earnings     Decimal?      @db.Decimal(10, 2)
  payment_status      PaymentStatus @default(pending)

  // OTP VERIFICATION
  ride_otp String? @db.VarChar(6)

  // RIDE PREFERENCES
  allow_pets     Boolean  @default(false)
  allow_smoking  Boolean  @default(false)
  allow_luggage  Boolean  @default(true)
  max_luggage_kg Decimal? @db.Decimal(5, 2)

  // NOTES
  ride_notes           String? @db.Text
  special_instructions String? @db.Text

  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  // RELATIONS
  creator   User     @relation("RideCreator", fields: [created_by], references: [user_id])
  passenger User?    @relation("RidePassenger", fields: [passenger_id], references: [user_id])
  vehicle   Vehicle  @relation(fields: [vehicle_id], references: [vehicle_id])
  driver    Partner? @relation("RideDriver", fields: [driver_id], references: [partner_id])

  // payments          Payment[]
  // partnerEarnings   PartnerEarning[]
  ratingsReviews    RatingsReview[]
  rideBookings      RideBooking[] // NEW: Multiple users can book seats
  user              User?            @relation(fields: [userUser_id], references: [user_id])
  userUser_id       BigInt?
  partner           Partner?         @relation(fields: [partnerPartner_id], references: [partner_id])
  partnerPartner_id BigInt?
  rideTrackings     RideTracking[]
  // supportTickets    SupportTicket[]
  // promoUsages       PromoUsage[]
  sosAlerts         SosAlert[]
  payments          Payment[]
  partnerEarnings   PartnerEarning[]
  supportTickets    SupportTicket[]
  promoUsages       PromoUsage[]

  @@index([created_by])
  @@index([passenger_id])
  @@index([driver_id])
  @@index([ride_status])
  @@index([ride_type])
  @@index([scheduled_departure_time])
  @@map("rides")
}

model RideBooking {
  booking_id BigInt @id @default(autoincrement())
  ride_id    BigInt
  user_id    BigInt

  seats_booked       Int?
  capacity_booked_kg Decimal? @db.Decimal(10, 2)

  fare_amount    Decimal?      @db.Decimal(10, 2)
  booking_status BookingStatus @default(pending)

  pickup_location_lat Decimal? @db.Decimal(10, 8)
  pickup_location_lng Decimal? @db.Decimal(11, 8)
  pickup_address      String?  @db.VarChar(255)

  drop_location_lat Decimal? @db.Decimal(10, 8)
  drop_location_lng Decimal? @db.Decimal(11, 8)
  drop_address      String?  @db.VarChar(255)

  special_requests    String? @db.Text
  cancellation_reason String? @db.Text

  payment_id BigInt?

  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  // RELATIONS
  // Note: Ensure the references: [ride_id] matches the name in your updated Ride model
  ride    Ride     @relation(fields: [ride_id], references: [ride_id])
  user    User     @relation(fields: [user_id], references: [user_id])
  payment Payment? @relation(fields: [payment_id], references: [payment_id])

  @@index([ride_id])
  @@index([user_id])
  @@index([booking_status])
  @@map("ride_bookings")
}

model RentalBooking {
  booking_id   BigInt @id @default(autoincrement())
  passenger_id BigInt
  vehicle_id   BigInt
  owner_id     BigInt

  // Rental Period
  start_date            DateTime @db.Date
  start_time            DateTime @db.Time(0)
  end_date              DateTime @db.Date
  end_time              DateTime @db.Time(0)
  rental_duration_hours Int?
  rental_duration_days  Int?

  // Pricing
  price_per_hour      Decimal? @db.Decimal(10, 2)
  price_per_day       Decimal? @db.Decimal(10, 2)
  total_rental_amount Decimal? @db.Decimal(10, 2)
  security_deposit    Decimal? @db.Decimal(10, 2)
  tax_amount          Decimal? @db.Decimal(10, 2)
  total_amount        Decimal? @db.Decimal(10, 2)

  // Pickup/Return Location
  pickup_location String? @db.Text
  return_location String? @db.Text

  // Status
  booking_status      BookingStatus @default(pending)
  cancellation_reason String?       @db.Text

  // Documents
  rental_agreement_url String? @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  passenger       User             @relation(fields: [passenger_id], references: [user_id], onDelete: Cascade)
  vehicle         Vehicle          @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  owner           Partner          @relation("owner_rentals", fields: [owner_id], references: [partner_id], onDelete: Cascade)
  payments        Payment[]
  earnings        PartnerEarning[]
  reviews         RatingsReview[]
  support_tickets SupportTicket[]
  promo_usage     PromoUsage[]

  @@index([passenger_id])
  @@index([vehicle_id])
  @@index([booking_status])
  @@map("rental_bookings")
}

// =====================================================
// RIDE TRACKING & LOCATION
// =====================================================

model RideTracking {
  tracking_id           BigInt   @id @default(autoincrement())
  ride_id               BigInt
  driver_latitude       Decimal? @db.Decimal(10, 8)
  driver_longitude      Decimal? @db.Decimal(11, 8)
  speed_kmph            Decimal? @db.Decimal(5, 2)
  heading               Decimal? @db.Decimal(5, 2)
  eta_minutes           Int?
  distance_to_pickup_km Decimal? @db.Decimal(10, 2)
  recorded_at           DateTime @default(now()) @db.Timestamp(0)

  // Relations
  ride Ride @relation(fields: [ride_id], references: [ride_id], onDelete: Cascade)

  @@index([ride_id, recorded_at])
  @@map("ride_tracking")
}

// =====================================================
// PAYMENTS
// =====================================================

model Payment {
  payment_id        BigInt          @id @default(autoincrement())
  transaction_type  TransactionType
  ride_id           BigInt?
  rental_booking_id BigInt?
  payer_id          BigInt
  payee_id          BigInt?

  amount         Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod
  payment_status PaymentStatus @default(pending)

  // Payment Gateway Details
  transaction_id   String? @unique @db.VarChar(100)
  gateway_name     String? @db.VarChar(50)
  gateway_response Json?

  payment_date DateTime @default(now()) @db.Timestamp(0)

  // Relations
  ride                     Ride?                      @relation(fields: [ride_id], references: [ride_id], onDelete: SetNull)
  rental_booking           RentalBooking?             @relation(fields: [rental_booking_id], references: [booking_id], onDelete: SetNull)
  payer                    User                       @relation("payer_payments", fields: [payer_id], references: [user_id], onDelete: Cascade)
  payee                    User?                      @relation("payee_payments", fields: [payee_id], references: [user_id], onDelete: SetNull)
  subscriptions            PartnerSubscription[]
  driverLeadUnlocks        DriverLeadUnlock[]
  marketplaceRegistrations DriverMarketplaceProfile[] @relation("marketplace_registration")
  rideBookings             RideBooking[]

  @@index([payer_id])
  @@index([transaction_id])
  @@index([payment_status])
  @@index([payment_date])
  @@map("payments")
}

model PartnerEarning {
  earning_id        BigInt  @id @default(autoincrement())
  partner_id        BigInt
  ride_id           BigInt?
  rental_booking_id BigInt?

  gross_amount          Decimal  @db.Decimal(10, 2)
  commission_percentage Decimal  @default(15.00) @db.Decimal(5, 2)
  commission_amount     Decimal  @default(0.00) @db.Decimal(10, 2)
  final_payout_amount   Decimal  @default(0.00) @db.Decimal(10, 2)
  net_earnings          Decimal? @db.Decimal(10, 2)

  payout_status         PayoutStatus @default(pending)
  payout_date           DateTime?    @db.Timestamp(0)
  payout_transaction_id String?      @db.VarChar(100)

  earned_at DateTime @default(now()) @db.Timestamp(0)

  // Relations
  partner        Partner        @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  ride           Ride?          @relation(fields: [ride_id], references: [ride_id], onDelete: SetNull)
  rental_booking RentalBooking? @relation(fields: [rental_booking_id], references: [booking_id], onDelete: SetNull)

  @@index([partner_id])
  @@index([payout_status])
  @@index([partner_id, earned_at])
  @@map("partner_earnings")
}

model PartnerSubscriptionPlan {
  plan_id               BigInt      @id @default(autoincrement())
  plan_name             String      @db.VarChar(100)
  billing_type          BillingType
  plan_price            Decimal     @db.Decimal(10, 2)
  lead_unlock_price     Decimal     @default(49.00) @db.Decimal(10, 2)
  commission_percentage Decimal     @default(0.00) @db.Decimal(5, 2)
  is_active             Boolean     @default(true)
  created_at            DateTime    @default(now()) @db.Timestamp(0)

  // Relations
  subscriptions PartnerSubscription[]

  @@map("partner_subscription_plans")
}

model PartnerSubscription {
  subscription_id     BigInt             @id @default(autoincrement())
  partner_id          BigInt
  plan_id             BigInt
  subscription_status SubscriptionStatus @default(pending)
  start_date          DateTime?          @db.Timestamp(0)
  end_date            DateTime?          @db.Timestamp(0)
  payment_id          BigInt?
  created_at          DateTime           @default(now()) @db.Timestamp(0)

  // Relations
  partner Partner                 @relation(fields: [partner_id], references: [partner_id])
  plan    PartnerSubscriptionPlan @relation(fields: [plan_id], references: [plan_id])
  payment Payment?                @relation(fields: [payment_id], references: [payment_id])

  @@index([partner_id])
  @@map("partner_subscriptions")
}

// =====================================================
// DRIVER MARKETPLACE - SEPARATE PROFILE TABLE
// =====================================================

// New separate table for marketplace profiles
model DriverMarketplaceProfile {
  profile_id BigInt @id @default(autoincrement())
  partner_id BigInt @unique

  // Location & Service Area
  home_location_lat Decimal? @db.Decimal(10, 8)
  home_location_lng Decimal? @db.Decimal(11, 8)
  service_city      String?  @db.VarChar(100)
  service_radius_km Int      @default(50)
  service_areas     Json? // ["Guwahati", "Jorhat", "Dibrugarh"]

  // Profile Information
  marketplace_bio     String? @db.Text
  specializations     Json? // ["Airport Transfer", "Outstation", "Corporate"]
  languages_spoken    Json? // ["English", "Hindi", "Assamese"]
  available_hours     Json? // {"monday": "9am-9pm", "tuesday": "all day"}
  years_of_experience Int?

  // Vehicle Details (from partner's vehicles)
  primary_vehicle_type String? @db.VarChar(50)
  own_vehicle          Boolean @default(false)
  willing_to_relocate  Boolean @default(false)

  // Documents & Verification
  has_valid_license    Boolean @default(false)
  has_police_clearance Boolean @default(false)
  verification_badge   String? @db.VarChar(50) // "verified", "premium"

  // Marketplace Status
  marketplace_status  MarketplaceStatus @default(inactive)
  show_in_marketplace Boolean           @default(false)

  // Registration & Expiry
  registration_payment_id   BigInt?
  marketplace_registered_at DateTime? @db.Timestamp(0)
  marketplace_expires_at    DateTime? @db.Timestamp(0)

  // Analytics
  profile_view_count   Int       @default(0)
  total_leads_received Int       @default(0)
  last_viewed_at       DateTime? @db.Timestamp(0)

  // Preferences
  preferred_job_type  Json?    @map("preferred_job_type") // ["full_time", "part_time", "contract"]
  expected_salary_min Decimal? @db.Decimal(10, 2)
  expected_salary_max Decimal? @db.Decimal(10, 2)

  // SEO & Search
  search_keywords      String? @db.VarChar(500)
  profile_completeness Int     @default(0) // 0-100%

  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  partner             Partner            @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  registrationPayment Payment?           @relation("marketplace_registration", fields: [registration_payment_id], references: [payment_id])
  leadUnlocks         DriverLeadUnlock[]

  @@index([service_city])
  @@index([marketplace_status])
  @@index([show_in_marketplace])
  @@index([home_location_lat, home_location_lng])
  @@map("driver_marketplace_profiles")
}

// Driver Lead Unlocks (User pays to see driver details)
model DriverLeadUnlock {
  unlock_id  BigInt @id @default(autoincrement())
  user_id    BigInt
  partner_id BigInt
  profile_id BigInt
  payment_id BigInt

  // Payment (₹49 - 100% to platform)
  amount_paid    Decimal       @default(49.00) @db.Decimal(10, 2)
  payment_status PaymentStatus @default(pending)

  // Access Control
  contact_revealed Boolean   @default(false)
  revealed_at      DateTime? @db.Timestamp(0)
  valid_until      DateTime? @db.Timestamp(0) // 30 days access
  is_expired       Boolean   @default(false)

  // Lead Tracking (User's perspective)
  lead_status          LeadStatus    @default(new)
  lead_notes           String?       @db.Text
  contact_viewed_count Int           @default(0)
  last_viewed_at       DateTime?     @db.Timestamp(0)
  user_feedback        String?       @db.Text
  hiring_status        HiringStatus?

  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  user    User                     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  partner Partner                  @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  profile DriverMarketplaceProfile @relation(fields: [profile_id], references: [profile_id], onDelete: Cascade)
  payment Payment                  @relation(fields: [payment_id], references: [payment_id], onDelete: Restrict)

  @@unique([user_id, partner_id], name: "uq_user_partner_unlock")
  @@index([user_id, created_at])
  @@index([partner_id, lead_status])
  @@index([profile_id])
  @@index([payment_status])
}

// =====================================================
// RATINGS & REVIEWS
// =====================================================

model RatingsReview {
  review_id         BigInt     @id @default(autoincrement())
  review_type       ReviewType
  ride_id           BigInt?
  rental_booking_id BigInt?
  reviewer_id       BigInt
  reviewee_id       BigInt?
  vehicle_id        BigInt?

  rating      Int
  review_text String? @db.Text
  review_tags Json? // ["Clean", "Polite", "On Time"]

  is_visible    Boolean   @default(true)
  response_text String?   @db.Text
  responded_at  DateTime? @db.Timestamp(0)

  created_at DateTime @default(now()) @db.Timestamp(0)

  // Relations
  ride           Ride?          @relation(fields: [ride_id], references: [ride_id], onDelete: Cascade)
  rental_booking RentalBooking? @relation(fields: [rental_booking_id], references: [booking_id], onDelete: Cascade)
  reviewer       User           @relation("reviewer", fields: [reviewer_id], references: [user_id], onDelete: Cascade)
  reviewee       User?          @relation("reviewee", fields: [reviewee_id], references: [user_id], onDelete: SetNull)
  vehicle        Vehicle?       @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: SetNull)

  @@index([reviewer_id])
  @@index([reviewee_id])
  @@index([vehicle_id])
  @@map("ratings_reviews")
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  notification_id   BigInt           @id @default(autoincrement())
  user_id           BigInt
  notification_type NotificationType
  title             String           @db.VarChar(255)
  message           String           @db.Text
  data              Json? // Additional data for deep linking

  is_read Boolean   @default(false)
  read_at DateTime? @db.Timestamp(0)

  sent_at DateTime @default(now()) @db.Timestamp(0)

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@map("notifications")
}

model PushToken {
  token_id     BigInt     @id @default(autoincrement())
  user_id      BigInt
  device_token String     @db.VarChar(255)
  device_type  DeviceType
  is_active    Boolean    @default(true)
  created_at   DateTime   @default(now()) @db.Timestamp(0)
  updated_at   DateTime   @default(now()) @updatedAt @db.Timestamp(0)

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, device_token])
  @@index([is_active])
  @@map("push_tokens")
}

// =====================================================
// Location  & service
// =====================================================

model District {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  major_points MajorPoint[]
  created_at   DateTime     @default(now()) @db.Timestamp(0)
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamp(0)

  @@map("districts")
}

model MajorPoint {
  id          Int      @id @default(autoincrement())
  name        String
  district_id Int
  district    District @relation(fields: [district_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@unique([name, district_id])
  @@map("major_points")
}

// =====================================================
// SUPPORT & HELP
// =====================================================

model SupportTicket {
  ticket_id         BigInt  @id @default(autoincrement())
  user_id           BigInt
  ride_id           BigInt?
  rental_booking_id BigInt?

  ticket_type TicketType
  priority    Priority   @default(medium)
  subject     String     @db.VarChar(255)
  description String     @db.Text

  status           TicketStatus @default(open)
  assigned_to      BigInt? // Admin user ID
  resolution_notes String?      @db.Text

  created_at  DateTime  @default(now()) @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  resolved_at DateTime? @db.Timestamp(0)

  // Relations
  user           User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  ride           Ride?          @relation(fields: [ride_id], references: [ride_id], onDelete: SetNull)
  rental_booking RentalBooking? @relation(fields: [rental_booking_id], references: [booking_id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("support_tickets")
}

model Faq {
  faq_id        BigInt      @id @default(autoincrement())
  category      FaqCategory
  question      String      @db.Text
  answer        String      @db.Text
  display_order Int         @default(0)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @updatedAt @db.Timestamp(0)

  @@index([category, is_active])
  @@map("faqs")
}

// =====================================================
// PROMO CODES & OFFERS
// =====================================================

model PromoCode {
  promo_id            BigInt       @id @default(autoincrement())
  promo_code          String       @unique @db.VarChar(50)
  description         String?      @db.VarChar(255)
  discount_type       DiscountType
  discount_value      Decimal      @db.Decimal(10, 2)
  max_discount_amount Decimal?     @db.Decimal(10, 2)
  min_order_amount    Decimal?     @db.Decimal(10, 2)

  usage_limit_per_user Int  @default(1)
  total_usage_limit    Int?
  times_used           Int  @default(0)

  valid_from  DateTime @db.Timestamp(0)
  valid_until DateTime @db.Timestamp(0)
  is_active   Boolean  @default(true)

  applicable_to ApplicableTo  @default(all)
  user_type     PromoUserType @default(all)

  created_at DateTime @default(now()) @db.Timestamp(0)

  // Relations
  usage PromoUsage[]

  @@index([promo_code])
  @@index([is_active, valid_from, valid_until])
  @@map("promo_codes")
}

model PromoUsage {
  usage_id          BigInt   @id @default(autoincrement())
  promo_id          BigInt
  user_id           BigInt
  ride_id           BigInt?
  rental_booking_id BigInt?
  discount_applied  Decimal? @db.Decimal(10, 2)
  used_at           DateTime @default(now()) @db.Timestamp(0)

  // Relations
  promo          PromoCode      @relation(fields: [promo_id], references: [promo_id], onDelete: Cascade)
  user           User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  ride           Ride?          @relation(fields: [ride_id], references: [ride_id], onDelete: SetNull)
  rental_booking RentalBooking? @relation(fields: [rental_booking_id], references: [booking_id], onDelete: SetNull)

  @@index([user_id, promo_id])
  @@map("promo_usage")
}

// =====================================================
// EMERGENCY SOS
// =====================================================

model EmergencyContact {
  contact_id    BigInt   @id @default(autoincrement())
  user_id       BigInt
  contact_name  String   @db.VarChar(100)
  contact_phone String   @db.VarChar(20)
  relationship  String?  @db.VarChar(50)
  is_primary    Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(0)

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("emergency_contacts")
}

model SosAlert {
  sos_id  BigInt  @id @default(autoincrement())
  user_id BigInt
  ride_id BigInt?

  alert_type       AlertType
  latitude         Decimal?  @db.Decimal(10, 8)
  longitude        Decimal?  @db.Decimal(11, 8)
  location_address String?   @db.Text

  alert_status   AlertStatus @default(active)
  response_notes String?     @db.Text

  triggered_at DateTime  @default(now()) @db.Timestamp(0)
  resolved_at  DateTime? @db.Timestamp(0)

  // Relations
  user User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  ride Ride? @relation(fields: [ride_id], references: [ride_id], onDelete: SetNull)

  @@index([alert_status, triggered_at])
  @@map("sos_alerts")
}

// =====================================================
// ANALYTICS & LOGS
// =====================================================

model AppSession {
  session_id  BigInt      @id @default(autoincrement())
  user_id     BigInt
  device_id   String?     @db.VarChar(255)
  device_type DeviceType?
  app_version String?     @db.VarChar(20)
  os_version  String?     @db.VarChar(20)

  session_start    DateTime  @default(now()) @db.Timestamp(0)
  session_end      DateTime? @db.Timestamp(0)
  duration_seconds Int?

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, session_start])
  @@map("app_sessions")
}

model SearchLog {
  search_id       BigInt      @id @default(autoincrement())
  user_id         BigInt?
  search_type     SearchType?
  pickup_location String?     @db.Text
  drop_location   String?     @db.Text
  vehicle_type    String?     @db.VarChar(50)
  search_date     DateTime?   @db.Date
  search_time     DateTime?   @db.Time(0)
  results_count   Int?
  booking_made    Boolean     @default(false)
  searched_at     DateTime    @default(now()) @db.Timestamp(0)

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id, searched_at])
  @@map("search_logs")
}

// =====================================================
// ADMIN CONFIGURATIONS
// =====================================================

model AppConfiguration {
  config_id    BigInt   @id @default(autoincrement())
  config_key   String   @unique @db.VarChar(100)
  config_value String   @db.Text
  description  String?  @db.Text
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@map("app_configurations")
}

