// GoTrip database schema (PostgreSQL)
//
// Conventions
//  - Models/fields are camelCase in code, snake_case in the database (@map / @@map).
//  - Prices are whole rupees (Int). Payment amounts are paise (Int), as Razorpay expects.
//  - Uploaded files are stored as storage *keys* (S3 or local disk), never as public URLs,
//    so private documents can only be read through short-lived signed URLs.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// USERS, AUTH, DEVICES
// =====================================================

model User {
  id          Int        @id @default(autoincrement())
  phone       String     @unique @db.VarChar(15) // E.164, e.g. +919876543210
  fullName    String?    @map("full_name") @db.VarChar(100)
  email       String?    @db.VarChar(150)
  photoKey    String?    @map("photo_key") @db.VarChar(255)
  gender      Gender?
  dateOfBirth DateTime?  @map("date_of_birth") @db.Date
  city        String?    @db.VarChar(80)
  /// UI / notification language: "en" | "as"
  language    String     @default("en") @db.VarChar(5)
  status      UserStatus @default(active)
  blockReason String?    @map("block_reason") @db.VarChar(255)
  lastLoginAt DateTime?  @map("last_login_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  partner       Partner?
  sessions      Session[]
  pushTokens    PushToken[]
  bookings      Booking[]
  notifications Notification[]
  payments      Payment[]
  savedPlaces   SavedPlace[]
  tickets       SupportTicket[]
  goodsOrders   GoodsOrder[]
  reviews       Review[]
  contactEvents ContactEvent[]

  @@index([createdAt])
  @@index([status])
  @@map("users")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  phone      String     @db.VarChar(15)
  codeHash   String     @map("code_hash") @db.VarChar(64)
  purpose    OtpPurpose @default(login)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

/// Refresh-token sessions. Only a SHA-256 hash of the token is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     Int       @map("user_id")
  app        AppKind
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  deviceInfo String?   @map("device_info") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(255)
  app       AppKind
  platform  Platform
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, app, isActive])
  @@map("push_tokens")
}

model SavedPlace {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  label     String   @db.VarChar(50)
  address   String   @db.VarChar(255)
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_places")
}

// =====================================================
// PARTNER CATEGORIES & DOCUMENT REQUIREMENTS (configurable)
// =====================================================

model PartnerCategory {
  id                 Int      @id @default(autoincrement())
  code               String   @unique @db.VarChar(40) // driver | rental | commercial | ...
  name               String   @db.VarChar(80)
  description        String?  @db.VarChar(255)
  icon               String?  @db.VarChar(50)
  /// Registration / listing fee in paise. 0 = free.
  registrationFee    Int      @default(0) @map("registration_fee")
  /// How long a paid listing stays active. null = lifetime.
  feeValidityDays    Int?     @map("fee_validity_days")
  hasDriverProfile   Boolean  @default(false) @map("has_driver_profile")
  canListVehicles    Boolean  @default(false) @map("can_list_vehicles")
  canCreateTrips     Boolean  @default(false) @map("can_create_trips")
  canListRentals     Boolean  @default(false) @map("can_list_rentals")
  canViewGoodsOrders Boolean  @default(false) @map("can_view_goods_orders")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  /// Other languages, e.g. { "as": { "name": "...", "description": "..." } }
  translations       Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  requirements DocumentRequirement[]
  partners     Partner[]

  @@map("partner_categories")
}

model DocumentRequirement {
  id             Int           @id @default(autoincrement())
  categoryId     Int           @map("category_id")
  scope          DocumentScope @default(partner)
  docType        String        @map("doc_type") @db.VarChar(40)
  label          String        @db.VarChar(80)
  hint           String?       @db.VarChar(255)
  isRequired     Boolean       @default(true) @map("is_required")
  requiresNumber Boolean       @default(false) @map("requires_number")
  requiresExpiry Boolean       @default(false) @map("requires_expiry")
  requiresBack   Boolean       @default(false) @map("requires_back")
  sortOrder      Int           @default(0) @map("sort_order")
  /// e.g. { "as": { "label": "...", "hint": "..." } }
  translations   Json?

  category PartnerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, scope, docType])
  @@map("document_requirements")
}

// =====================================================
// PARTNERS
// =====================================================

model Partner {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique @map("user_id")
  categoryId         Int                @map("category_id")
  businessName       String?            @map("business_name") @db.VarChar(120)
  alternatePhone     String?            @map("alternate_phone") @db.VarChar(15)
  whatsappPhone      String?            @map("whatsapp_phone") @db.VarChar(15)
  address            String?            @db.VarChar(255)
  district           String?            @db.VarChar(80)
  city               String?            @db.VarChar(80)
  pincode            String?            @db.VarChar(10)
  accountStatus      PartnerAccount     @default(onboarding) @map("account_status")
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(500)
  suspendedReason    String?            @map("suspended_reason") @db.VarChar(500)
  submittedAt        DateTime?          @map("submitted_at")
  verifiedAt         DateTime?          @map("verified_at")
  activatedAt        DateTime?          @map("activated_at")
  feePaidAt          DateTime?          @map("fee_paid_at")
  /// End of the paid listing period (null = no expiry / not applicable).
  listingExpiresAt   DateTime?          @map("listing_expires_at")
  ratingAvg          Float              @default(0) @map("rating_avg")
  ratingCount        Int                @default(0) @map("rating_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      PartnerCategory   @relation(fields: [categoryId], references: [id])
  documents     PartnerDocument[]
  driverProfile DriverProfile?
  vehicles      Vehicle[]
  trips         Trip[]
  bookings      Booking[]
  payments      Payment[]
  locationShare LocationShare?
  reviews       Review[]
  contactEvents ContactEvent[]

  @@index([categoryId, accountStatus])
  @@index([verificationStatus])
  @@index([createdAt])
  @@map("partners")
}

model PartnerDocument {
  id              Int            @id @default(autoincrement())
  partnerId       Int            @map("partner_id")
  docType         String         @map("doc_type") @db.VarChar(40)
  docNumber       String?        @map("doc_number") @db.VarChar(60)
  expiryDate      DateTime?      @map("expiry_date") @db.Date
  frontKey        String         @map("front_key") @db.VarChar(255)
  backKey         String?        @map("back_key") @db.VarChar(255)
  status          DocumentStatus @default(pending)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(255)
  reviewedAt      DateTime?      @map("reviewed_at")
  reviewedBy      Int?           @map("reviewed_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, docType])
  @@index([status])
  @@map("partner_documents")
}

/// Marketplace profile for partners in a category with hasDriverProfile = true.
model DriverProfile {
  id                 Int       @id @default(autoincrement())
  partnerId          Int       @unique @map("partner_id")
  headline           String?   @db.VarChar(120)
  bio                String?   @db.VarChar(1000)
  hasPriorExperience Boolean   @default(false) @map("has_prior_experience")
  experienceYears    Int       @default(0) @map("experience_years")
  experienceDetails  String?   @map("experience_details") @db.VarChar(1000)
  licenseNumber      String?   @map("license_number") @db.VarChar(40)
  licenseTypes       String[]  @default([]) @map("license_types") // LMV, HMV, MCWG, TRANS
  licenseExpiry      DateTime? @map("license_expiry") @db.Date
  vehicleTypes       String[]  @default([]) @map("vehicle_types") // car, suv, truck, bus...
  canDriveAutomatic  Boolean   @default(false) @map("can_drive_automatic")
  languages          String[]  @default([])
  serviceAreas       String[]  @default([]) @map("service_areas")
  workTypes          String[]  @default([]) @map("work_types") // personal, outstation, commercial, daily
  availability       String?   @db.VarChar(30) // full_time | part_time | on_call
  expectedPayMin     Int?      @map("expected_pay_min")
  expectedPayMax     Int?      @map("expected_pay_max")
  payUnit            String?   @map("pay_unit") @db.VarChar(20) // per_day | per_month | per_trip
  education          String?   @db.VarChar(80)
  hasOwnVehicle      Boolean   @default(false) @map("has_own_vehicle")
  district           String?   @db.VarChar(80)
  city               String?   @db.VarChar(80)
  lat                Float?
  lng                Float?
  isAvailable        Boolean   @default(true) @map("is_available")
  /// Denormalised visibility flag kept in sync by the service layer (fast marketplace queries).
  isListed           Boolean   @default(false) @map("is_listed")
  listedAt           DateTime? @map("listed_at")
  completeness       Int       @default(0)
  viewCount          Int       @default(0) @map("view_count")
  callCount          Int       @default(0) @map("call_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([isListed, district])
  @@index([isListed, experienceYears])
  @@index([isListed, listedAt])
  @@map("driver_profiles")
}

// =====================================================
// VEHICLES
// =====================================================

model Vehicle {
  id                 Int          @id @default(autoincrement())
  partnerId          Int          @map("partner_id")
  /// passenger = carries people (seats); commercial = carries goods (load capacity)
  category           VehicleCategory @default(passenger)
  vehicleClass       VehicleClass @map("vehicle_class")
  make               String       @db.VarChar(50)
  model              String       @db.VarChar(50)
  year               Int?
  color              String?      @db.VarChar(30)
  registrationNumber String       @unique @map("registration_number") @db.VarChar(20)
  seats              Int?
  loadCapacityKg     Int?         @map("load_capacity_kg")
  /// Goods vehicles: open, closed, container, flatbed, tipper, tanker, refrigerated
  bodyType           String?      @map("body_type") @db.VarChar(30)
  cargoLengthFt      Float?       @map("cargo_length_ft")
  fuelType           FuelType?    @map("fuel_type")
  hasAc              Boolean      @default(false) @map("has_ac")
  features           String[]     @default([])
  description        String?      @db.VarChar(1000)
  photoKeys          String[]     @default([]) @map("photo_keys")

  // How the vehicle is used
  forTrips  Boolean @default(false) @map("for_trips")
  forRental Boolean @default(false) @map("for_rental")
  forGoods  Boolean @default(false) @map("for_goods")

  // Status
  isAvailable        Boolean            @default(true) @map("is_available")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(500)
  submittedAt        DateTime           @default(now()) @map("submitted_at")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedBy         Int?               @map("verified_by")

  // Rental listing
  rentalAvailable    Boolean             @default(false) @map("rental_available")
  rentalPricePerDay  Int?                @map("rental_price_per_day")
  rentalPricePerHour Int?                @map("rental_price_per_hour")
  rentalDriverOption RentalDriverOption? @map("rental_driver_option")
  securityDeposit    Int?                @map("security_deposit")
  rentalMinHours     Int?                @map("rental_min_hours")
  rentalDistrict     String?             @map("rental_district") @db.VarChar(80)
  rentalCity         String?             @map("rental_city") @db.VarChar(80)
  rentalAddress      String?             @map("rental_address") @db.VarChar(255)
  rentalLat          Float?              @map("rental_lat")
  rentalLng          Float?              @map("rental_lng")
  rentalTerms        String?             @map("rental_terms") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner   Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  documents VehicleDocument[]
  trips     Trip[]

  @@index([partnerId])
  @@index([verificationStatus, submittedAt])
  @@index([forRental, verificationStatus, rentalDistrict])
  @@index([rentalLat, rentalLng])
  @@map("vehicles")
}

model VehicleDocument {
  id              Int            @id @default(autoincrement())
  vehicleId       Int            @map("vehicle_id")
  docType         String         @map("doc_type") @db.VarChar(40)
  docNumber       String?        @map("doc_number") @db.VarChar(60)
  expiryDate      DateTime?      @map("expiry_date") @db.Date
  frontKey        String         @map("front_key") @db.VarChar(255)
  backKey         String?        @map("back_key") @db.VarChar(255)
  status          DocumentStatus @default(pending)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(255)
  reviewedAt      DateTime?      @map("reviewed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, docType])
  @@map("vehicle_documents")
}

// =====================================================
// TRIPS (Start trips and Return trips) & BOOKING REQUESTS
// =====================================================

model Trip {
  id              Int        @id @default(autoincrement())
  partnerId       Int        @map("partner_id")
  vehicleId       Int        @map("vehicle_id")
  tripType        TripType   @map("trip_type")
  /// passenger = seat sharing; goods = the whole vehicle is hired to carry a load on this route
  kind            TripKind   @default(passenger)
  capacityKg      Int?       @map("capacity_kg")
  /// For a return trip: the outbound trip it returns from (optional).
  parentTripId    Int?       @map("parent_trip_id")
  originName      String     @map("origin_name") @db.VarChar(120)
  destinationName String     @map("destination_name") @db.VarChar(120)
  departureAt     DateTime   @map("departure_at")
  arrivalAt       DateTime?  @map("arrival_at")
  totalSeats      Int        @map("total_seats")
  availableSeats  Int        @map("available_seats")
  pricePerSeat    Int        @map("price_per_seat")
  acceptsParcels  Boolean    @default(false) @map("accepts_parcels")
  /// Partner can pause new booking requests without cancelling the trip.
  bookingOpen     Boolean    @default(true) @map("booking_open")
  notes           String?    @db.VarChar(500)
  status          TripStatus @default(scheduled)
  cancelReason    String?    @map("cancel_reason") @db.VarChar(255)
  startedAt       DateTime?  @map("started_at")
  completedAt     DateTime?  @map("completed_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  partner     Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  parentTrip  Trip?      @relation("ReturnTrip", fields: [parentTripId], references: [id], onDelete: SetNull)
  returnTrips Trip[]     @relation("ReturnTrip")
  stops       TripStop[]
  bookings    Booking[]

  @@index([status, departureAt])
  @@index([kind, status, departureAt])
  @@index([partnerId, departureAt])
  @@index([vehicleId, departureAt])
  @@map("trips")
}

/// Ordered stops of a trip: seq 0 = origin, last = destination, everything between is a pickup/drop point.
model TripStop {
  id            Int     @id @default(autoincrement())
  tripId        Int     @map("trip_id")
  seq           Int
  placeName     String  @map("place_name") @db.VarChar(120)
  /// Lower-cased, trimmed name used for searching.
  placeKey      String  @map("place_key") @db.VarChar(120)
  district      String? @db.VarChar(80)
  lat           Float?
  lng           Float?
  /// Optional fare from the origin to this stop (rupees). Used to estimate partial-route fares.
  fareFromStart Int?    @map("fare_from_start")
  /// Minutes after departure the vehicle is expected here.
  etaMinutes    Int?    @map("eta_minutes")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seq])
  @@index([placeKey])
  @@index([district])
  @@map("trip_stops")
}

model Booking {
  id             Int           @id @default(autoincrement())
  code           String        @unique @db.VarChar(12)
  tripId         Int           @map("trip_id")
  userId         Int           @map("user_id")
  partnerId      Int           @map("partner_id")
  seats          Int
  pickupSeq      Int           @map("pickup_seq")
  dropSeq        Int           @map("drop_seq")
  pickupName     String        @map("pickup_name") @db.VarChar(120)
  dropName       String        @map("drop_name") @db.VarChar(120)
  fareEstimate   Int           @map("fare_estimate")
  passengerName  String?       @map("passenger_name") @db.VarChar(100)
  passengerPhone String        @map("passenger_phone") @db.VarChar(15)
  note           String?       @db.VarChar(300)
  /// Goods trips: what is being carried and roughly how heavy
  goodsType      String?       @map("goods_type") @db.VarChar(80)
  loadKg         Int?          @map("load_kg")
  status         BookingStatus @default(pending)
  statusReason   String?       @map("status_reason") @db.VarChar(255)
  cancelledBy    Actor?        @map("cancelled_by")
  respondedAt    DateTime?     @map("responded_at")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  review  Review?

  @@index([partnerId, status, createdAt])
  @@index([userId, createdAt])
  @@index([tripId, status])
  @@map("bookings")
}

// =====================================================
// GOODS TRANSPORT ORDERS (feature flagged - disabled by default)
// =====================================================

model GoodsOrder {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  pickupName     String           @map("pickup_name") @db.VarChar(160)
  pickupDistrict String?          @map("pickup_district") @db.VarChar(80)
  pickupLat      Float?           @map("pickup_lat")
  pickupLng      Float?           @map("pickup_lng")
  dropName       String           @map("drop_name") @db.VarChar(160)
  dropDistrict   String?          @map("drop_district") @db.VarChar(80)
  dropLat        Float?           @map("drop_lat")
  dropLng        Float?           @map("drop_lng")
  goodsType      String           @map("goods_type") @db.VarChar(80)
  weightKg       Int?             @map("weight_kg")
  vehicleClass   VehicleClass?    @map("vehicle_class")
  pickupDate     DateTime         @map("pickup_date")
  description    String?          @db.VarChar(1000)
  contactPhone   String           @map("contact_phone") @db.VarChar(15)
  budget         Int?
  status         GoodsOrderStatus @default(open)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, pickupDate])
  @@index([pickupDistrict, status])
  @@map("goods_orders")
}

// =====================================================
// PAYMENTS (registration / listing fee only)
// =====================================================

model Payment {
  id                Int            @id @default(autoincrement())
  userId            Int            @map("user_id")
  partnerId         Int            @map("partner_id")
  purpose           PaymentPurpose @default(registration_fee)
  amount            Int // paise
  currency          String         @default("INR") @db.VarChar(3)
  status            PaymentStatus  @default(created)
  razorpayOrderId   String         @unique @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?        @unique @map("razorpay_payment_id") @db.VarChar(64)
  razorpaySignature String?        @map("razorpay_signature") @db.VarChar(128)
  method            String?        @db.VarChar(30)
  failureReason     String?        @map("failure_reason") @db.VarChar(255)
  receipt           String         @unique @db.VarChar(40)
  paidAt            DateTime?      @map("paid_at")
  /// Listing period covered by this payment.
  validUntil        DateTime?      @map("valid_until")
  categoryCode      String         @map("category_code") @db.VarChar(40)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Razorpay webhook log (idempotency + audit).
model PaymentWebhookEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @map("event_id") @db.VarChar(64)
  event       String   @db.VarChar(60)
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("payment_webhook_events")
}

// =====================================================
// LIVE LOCATION SHARING (low-cost: latest point only)
// =====================================================

model LocationShare {
  partnerId Int       @id @map("partner_id")
  isSharing Boolean   @default(false) @map("is_sharing")
  lat       Float?
  lng       Float?
  accuracyM Float?    @map("accuracy_m")
  tripId    Int?      @map("trip_id")
  startedAt DateTime? @map("started_at")
  expiresAt DateTime? @map("expires_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("location_shares")
}

// =====================================================
// NOTIFICATIONS, CONTACT ANALYTICS
// =====================================================

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  app       AppKind
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(150)
  body      String    @db.VarChar(500)
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, app, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Every "Call" / "WhatsApp" tap on a listing. Powers partner insights.
model ContactEvent {
  id         Int           @id @default(autoincrement())
  partnerId  Int           @map("partner_id")
  userId     Int?          @map("user_id")
  targetType ContactTarget @map("target_type")
  targetId   Int           @map("target_id")
  channel    String        @default("call") @db.VarChar(15)
  createdAt  DateTime      @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt])
  @@map("contact_events")
}

// =====================================================
// LOCATIONS (districts & major points)
// =====================================================

model District {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  state     String   @default("Assam") @db.VarChar(60)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  places Place[]

  @@map("districts")
}

model Place {
  id         Int      @id @default(autoincrement())
  districtId Int      @map("district_id")
  name       String   @db.VarChar(120)
  nameKey    String   @map("name_key") @db.VarChar(120)
  lat        Float?
  lng        Float?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, nameKey])
  @@index([nameKey])
  @@map("places")
}

// =====================================================
// SUPPORT
// =====================================================

model SupportTicket {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  app        AppKind
  category   String       @db.VarChar(40)
  subject    String       @db.VarChar(150)
  message    String       @db.VarChar(2000)
  status     TicketStatus @default(open)
  adminReply String?      @map("admin_reply") @db.VarChar(2000)
  repliedAt  DateTime?    @map("replied_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@map("support_tickets")
}

model Faq {
  id           Int         @id @default(autoincrement())
  audience     FaqAudience @default(all)
  question     String      @db.VarChar(300)
  answer       String      @db.VarChar(2000)
  /// e.g. { "as": { "question": "...", "answer": "..." } }
  translations Json?
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([audience, isActive])
  @@map("faqs")
}

// =====================================================
// ADMIN
// =====================================================

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(150)
  name         String    @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(100)
  role         AdminRole @default(admin)
  isActive     Boolean   @default(true) @map("is_active")
  /// Bumped on password change / forced logout to invalidate issued tokens.
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?     @map("admin_id")
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(40)
  details    Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Key/value runtime settings & feature flags (cached in memory).
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

