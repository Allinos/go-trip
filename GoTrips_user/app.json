{
  "expo": {
    "name": "GoTrip",
    "slug": "gotrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gotrip",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.gotrip.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GoTrip uses your location to show rental vehicles near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "in.gotrip.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoTrip uses your location to show rental vehicles near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF4444"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#EF4444",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:3000/api/v1"
    }
  }
}
